# ---------------------------------------------------------------------------
# Single source of truth for local dev. Copy to `.env` and adjust.
#   cp .env.example .env
# Both apps/api and apps/web read this root file (see apps/api/src/config/env.ts
# and apps/web/next.config.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- database (matches docker-compose.yml) ---------------------------------
APP_DB_URL=postgresql://ais:ais@localhost:5432/ais_dev
METADATA_DB_URL=postgresql://ais:ais@localhost:5433/ais_metadata
# Read-only role for generated queries; create it with `pnpm db:query-role`. Required in production.
QUERY_DB_URL=postgresql://ais_query:ais_query@localhost:5432/ais_dev

# --- api (apps/api) --------------------------------------------------------
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- web (apps/web) -------------------------------------------------------
# Exposed to the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side only, used by the /api/proxy/* rewrite.
API_URL=http://localhost:4000

# --- embeddings / model provider ------------------------------------------
# Used once you wire real embeddings into packages/db document_chunks.embedding
ANTHROPIC_API_KEY=
EMBEDDING_DIMENSIONS=1536

# --- LLM query generation --------------------------------------------------
# ollama uses the OpenAI-compatible endpoint; use any served local model name.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:32b
LLM_FALLBACK_MODEL=llama3.1:latest
LLM_TIMEOUT_MS=120000
LLM_BASE_URL=http://localhost:11434/v1
# Optional for local servers; OpenAI and Anthropic use their provider-specific keys.
LLM_API_KEY=
OPENAI_API_KEY=
# Per-provider models (used whichever provider is picked on screen). Blank = built-in default.
# LLM_MODEL / LLM_FALLBACK_MODEL still apply to LLM_PROVIDER when these are blank.
OLLAMA_MODEL=
OLLAMA_FALLBACK_MODEL=
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODEL=
# Extra models users may pick on screen (comma-separated). The default and fallback are always allowed.
OLLAMA_MODELS=
OPENAI_MODELS=
ANTHROPIC_MODELS=
BEDROCK_MODELS=
# For Bedrock, use AWS credentials from the standard SDK credential chain and set:
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# LLM_AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile   # run `aws sso login --profile <name>` first
# BEDROCK_INFERENCE_PROFILE_ID=  # inference profile ARN; takes precedence over BEDROCK_MODEL_ID
# BEDROCK_MODEL_ID=
